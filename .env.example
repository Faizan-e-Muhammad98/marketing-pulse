# Local development permits admin/admin if ADMIN_PASSWORD_HASH is unset.
# Production requires a password hash, session secret and shared Redis.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Exact public origin, no trailing slash (required behind a proxy).
APP_ORIGIN=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# AWS SDK default credential chain; use dedicated query-only permissions.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
CLOUDWATCH_LOG_GROUPS=
# Required regex without / delimiters. Include logger contexts for Marketing workers.
CLOUDWATCH_MARKETING_PATTERN=(?i)(GiftCard|Campaign|Journey|Loyalty|Review|Screen|Spotlight)
# Soft scanned-byte budget checked when polling (not a hard billing cap).
CLOUDWATCH_MAX_SCAN_BYTES=1073741824

NEW_RELIC_ACCOUNT_ID=
NEW_RELIC_USER_KEY=
NEW_RELIC_REGION=US
# Required for Errors/Query Performance. Marketing route scoping is enforced in code.
NEW_RELIC_APP_NAME=AIO_BACKEND_PROD
# Server-only NRQL WHERE expressions. Logs requires a filter. Errors/Queries filters
# are optional additional restrictions; they cannot widen the Marketing route scope.
# Example errors filter: appName = 'YOUR_BACKEND' AND request.uri LIKE '%gift-card%'
NEW_RELIC_LOGS_FILTER=
NEW_RELIC_ERRORS_FILTER=
NEW_RELIC_QUERIES_FILTER=

# Read-only PostgreSQL user, preferably on a replica. Never use application credentials.
# No sslmode query parameter: TLS settings are controlled below.
AUDIT_DATABASE_URL=
# PostgreSQL regex selecting audit event names belonging to Marketing.
AUDIT_EVENT_PATTERN=(Gift Card|Campaign|Journey|Loyalty|Review|Screen|Spotlight)
# TLS certificate verification is always enabled in production.
AUDIT_DB_SSL=require
# Optional PEM CA certificate (literal \n accepted), e.g. the RDS CA bundle.
AUDIT_DB_CA=
